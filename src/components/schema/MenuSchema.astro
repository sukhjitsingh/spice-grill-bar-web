---
import type { Menu, MenuItem, WithContext } from 'schema-dts';

import { menu } from '../../lib/menu';

const schema: WithContext<Menu> = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  name: 'Spice Grill & Bar Menu',
  url: 'https://spicegrillbar66.com/menu/',
  mainEntityOfPage: 'https://spicegrillbar66.com/menu/',
  inLanguage: 'en-US',
  hasMenuSection: menu.map((category) => ({
    '@type': 'MenuSection',
    name: category.category,
    hasMenuItem: category.items.map((item): MenuItem => ({
      '@type': 'MenuItem',
      name: item.name,
      ...(item.description ? { description: item.description } : {}),
      ...(item.veg ? { suitableForDiet: 'https://schema.org/VegetarianDiet' } : {}),
      offers: {
        '@type': 'Offer',
        price: item.price.toFixed(2),
        priceCurrency: 'USD',
      },
    })),
  })),
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
