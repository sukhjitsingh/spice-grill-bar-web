# Deployed as part of the build: upload the contents of dist/ (including this file) to public_html/.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical host: strip www and force HTTPS in a single 301 (no redirect chains)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # One URL per page: /index.html and /dir/index.html → the directory URL.
  # THE_REQUEST only matches what the visitor asked for, so the internal
  # DirectoryIndex lookup of index.html does not loop.
  RewriteCond %{THE_REQUEST} \s/+(?:[^?\s]*/)?index\.html[?\s] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  # Disable deprecated APIs to prevent PageSpeed warnings from third-party scripts (like GTM/Partytown)
  Header always set Permissions-Policy "attribution-reporting=(), shared-storage=()"
</IfModule>
